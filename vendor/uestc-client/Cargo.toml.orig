[package]
name = "uestc-client"
version = "0.4.0"
edition = "2024"
license = "MIT"
authors = ["kasuha07 <me@kasuha.com>"]
repository = "https://github.com/kasuha07/uestc-client"
description = "A minimal reqwest client for UESTC."

[features]
default = ["async"]
async = ["dep:tokio"]
blocking = ["reqwest/blocking"]

[dependencies]
reqwest = { version = "0.12", default-features = false, features = ["json", "cookies", "http2", "system-proxy", "default-tls"] }
tokio = { version = "1", features = ["full"], optional = true }
thiserror = "2"
scraper = "0.24"
aes = "0.8"
aes-gcm = "0.10"
cbc = "0.1"
base64 = "0.22"
rand = "0.9"
pbkdf2 = "0.12"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
cookie_store = "0.22"
reqwest_cookie_store = "0.9"
qr2term = "0.3"
quick-xml = "0.39"
url = "2.5"
regex = "1.12"
urlencoding = "2.1"
log = "0.4"

[dev-dependencies]
env_logger = "0.11"
