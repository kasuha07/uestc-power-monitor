[package]
name = "uestc-client"
version = "0.5.0"
edition = "2024"
license = "MIT"
authors = ["kasuha07 <me@kasuha.com>"]
repository = "https://github.com/kasuha07/uestc-client"
description = "A minimal reqwest client for UESTC."
# Explicit source-package inputs keep local captures and credentials out. The
# synthetic HTML must ship because library unit tests use include_str! on it.
include = [
    "/src/**/*.rs",
    "/tests/**/*.rs",
    "/tests/fixtures/reauth-page.html",
    "/examples/**/*.rs",
    "/docs/**/*.md",
    "/README.md",
    "/CONTEXT.md",
    "/LICENSE",
]

[features]
default = ["async"]
async = ["dep:tokio"]
blocking = ["reqwest/blocking"]

[dependencies]
reqwest = { version = "0.12", default-features = false, features = ["json", "cookies", "http2", "system-proxy", "default-tls"] }
tokio = { version = "1", features = ["full"], optional = true }
thiserror = "2"
scraper = "0.24"
aes = "0.8"
cbc = "0.1"
base64 = "0.22"
rand = "0.9"
# Cookie-at-rest encryption: AES-256-GCM with a PBKDF2-HMAC-SHA256 derived key.
aes-gcm = "0.10"
pbkdf2 = "0.12"
sha2 = "0.10"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
cookie_store = "0.22"
reqwest_cookie_store = "0.9"
qr2term = "0.3"
quick-xml = "0.39"
url = "2.5"
regex = "1.12"
urlencoding = "2.1"
log = "0.4"

[dev-dependencies]
env_logger = "0.11"
# 仅测试用：本机无系统 OpenSSL 时，让 openssl-sys 以 vendored 方式编译。
# dev-dependencies 不参与发布，不影响生产构建。
openssl = { version = "0.10", features = ["vendored"] }
